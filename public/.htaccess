# Hostinger (LiteSpeed) server config, copied to dist/ by Vite.
# If the server already has an .htaccess, merge these rules into it
# instead of overwriting it.

# Serve the web app manifest with its proper MIME type.
AddType application/manifest+json .webmanifest

# Always revalidate HTML so a new deploy is picked up right away
# (the hashed files in /assets can stay cached long-term).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# /index.html -> / (avoid a duplicate URL of the home page).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
